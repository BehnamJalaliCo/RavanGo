          }
        }
      }
    },
    "sample_welcome_content": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to RavanGo.\n\nTap the play button to start scrolling. Double-tap the reading area to play or pause. Tap once to show the controls.\n\nYou can adjust speed, text size, spacing, margins, and mirror mode at any time. Your scripts and settings stay on this device."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به RavanGo خوش آمدید.\n\nبرای شروع حرکت متن، دکمه پخش را بزنید. برای پخش یا مکث، دوبار روی ناحیه خواندن ضربه بزنید. با یک ضربه کنترل‌ها نمایش داده می‌شوند.\n\nهر زمان خواستید می‌توانید سرعت، اندازه متن، فاصله خطوط، حاشیه‌ها و حالت آینه‌ای را تغییر دهید. متن‌ها و تنظیمات شما روی همین دستگاه می‌مانند."
          }
        }
      }
    },
    "Create Script": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Script"
          }
        },
